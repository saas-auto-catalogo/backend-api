# ==============================================================================
# SaaS Auto Catálogo - Variáveis de Ambiente (Configuração de Produção e Dev)
# ==============================================================================

# ─── 1. BANCO DE DADOS POSTGRESQL (Multi-tenant) ──────────────────────────────
# URL de conexão no formato: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auto_catalogo_db?schema=public"

# ─── 2. AMBIENTE E SERVIDOR HTTP ──────────────────────────────────────────────
NODE_ENV="development" # 'development' | 'production' | 'test'
PORT=3000
HOST="0.0.0.0"

# ─── 3. REDIS & FILAS BULLMQ ──────────────────────────────────────────────────
# Conexão Redis para cache de feeds e processamento assíncrono em segundo plano
REDIS_URL="redis://localhost:6379"

# ─── 4. SEGURANÇA E FEED TOKENS ───────────────────────────────────────────────
# Salt global para cálculo de HMAC SHA-256 dos tokens públicos de feeds XML (Meta DAA)
# Gerar chave segura de 32+ caracteres em produção: openssl rand -hex 32
FEED_TOKEN_SECRET="feed-secret-salt-key-minimum-32-chars-length"

# Chave secreta para assinatura de JWTs de autenticação
JWT_SECRET="super-secret-jwt-signing-key-for-auth-minimum-32-chars"

# ─── 5. INTEGRAÇÃO STRIPE (Pagamentos e Assinaturas) ──────────────────────────
# Chaves oficiais do Stripe (obter no Dashboard do Stripe em Developers > API keys)
STRIPE_SECRET_KEY="sk_test_51...your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_...your_stripe_webhook_signing_secret"

# ─── 6. EMAILS TRANSACIONAIS (Resend) ─────────────────────────────────────────
# Chave de API do Resend para envio de emails de boas-vindas, reset de senha e alertas
RESEND_API_KEY="re_...your_resend_api_key"
EMAIL_FROM="SaaS Auto Catálogo <noreply@autocatalogo.com.br>"

# ─── 7. META GRAPH API (Integração Facebook / Instagram Ads) ──────────────────
# Credenciais do App na Meta for Developers (Login for Business & Graph API v21.0)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_API_VERSION="v21.0"
META_REDIRECT_URI="http://localhost:3000/api/v1/integrations/meta/callback"

# ─── 8. OBSERVABILIDADE & SENTRY ──────────────────────────────────────────────
# DSN do projeto no Sentry para captura de exceções em produção
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
