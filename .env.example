# ==============================================================================
# SaaS Auto Catálogo - Variáveis de Ambiente (Configuração de Produção e Dev)
# ==============================================================================

# ─── 1. BANCO DE DADOS POSTGRESQL (Multi-tenant) ──────────────────────────────
# URL de conexão no formato: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auto_catalogo_db?schema=public"

# ─── 2. AMBIENTE E SERVIDOR HTTP ──────────────────────────────────────────────
NODE_ENV="development" # 'development' | 'production' | 'test'
PORT=3000
HOST="0.0.0.0"
FRONTEND_URL="http://localhost:3000"

# ─── 3. REDIS & FILAS BULLMQ ──────────────────────────────────────────────────
# Conexão Redis para cache de feeds e processamento assíncrono em segundo plano
REDIS_URL="redis://localhost:6379"

# ─── 4. SEGURANÇA E FEED TOKENS ───────────────────────────────────────────────
# Salt global para cálculo de HMAC SHA-256 dos tokens públicos de feeds XML (Meta DAA)
# Gerar chave segura de 32+ caracteres em produção: openssl rand -hex 32
FEED_TOKEN_SECRET="feed-secret-salt-key-minimum-32-chars-length"

# Chave secreta para assinatura de JWTs de autenticação
JWT_SECRET="super-secret-jwt-signing-key-for-auth-minimum-32-chars"

# ─── 5. INTEGRAÇÃO STRIPE (Pagamentos e Assinaturas) ──────────────────────────
# Chaves oficiais do Stripe (obter no Dashboard do Stripe em Developers > API keys)
STRIPE_SECRET_KEY="sk_test_51...your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_...your_stripe_webhook_signing_secret"
# Força mock mesmo com STRIPE_SECRET_KEY (opcional; NODE_ENV=test já usa mock)
# STRIPE_MOCK="true"

# Price IDs do Stripe Dashboard (Products > Prices) — plano × intervalo
STRIPE_STARTER_MONTHLY_PRICE_ID="price_..."
STRIPE_STARTER_YEARLY_PRICE_ID="price_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_YEARLY_PRICE_ID="price_..."
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID="price_..."
STRIPE_ENTERPRISE_YEARLY_PRICE_ID="price_..."

# ─── 6. EMAILS TRANSACIONAIS (Resend) ─────────────────────────────────────────
# Chave de API do Resend para envio de emails de boas-vindas, reset de senha e alertas
RESEND_API_KEY="re_...your_resend_api_key"
EMAIL_FROM="SaaS Auto Catálogo <noreply@autocatalogo.com.br>"

# ─── 7. META GRAPH API (Integração Facebook / Instagram Ads) ──────────────────
# Credenciais do App na Meta for Developers (Login for Business & Graph API v21.0)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_API_VERSION="v21.0"
META_REDIRECT_URI="http://localhost:3000/api/v1/integrations/meta/callback"

# ─── 8. OBSERVABILIDADE & SENTRY ──────────────────────────────────────────────
# DSN do projeto no Sentry para captura de exceções em produção
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# ─── 9. DOCUMENTOS JURÍDICOS (legal-docs manifest) ────────────────────────────
# URL do manifest.json publicado pelo CI do legal-docs. Opcional — default aponta para main.
# LEGAL_DOCS_MANIFEST_URL="https://raw.githubusercontent.com/saas-auto-catalogo/legal-docs/main/manifest.json"

# ==============================================================================
# Variáveis obrigatórias em production
# ==============================================================================
#
# Com NODE_ENV=production, o backend valida o ambiente no boot e encerra com erro
# se alguma variável crítica estiver ausente ou inválida.
#
# | Variável                         | Obrigatória | Notas |
# |----------------------------------|-------------|-------|
# | DATABASE_URL                     | sim         | URL PostgreSQL válida |
# | JWT_SECRET                       | sim         | mínimo 32 caracteres; sem fallback |
# | REDIS_URL                        | sim         | URL redis:// ou rediss:// |
# | FEED_TOKEN_SECRET                | sim         | mínimo 32 caracteres |
# | FRONTEND_URL                     | sim         | URL HTTP(S) usada no CORS |
# | STRIPE_SECRET_KEY                | condicional | obrigatória se STRIPE_MOCK != true |
# | STRIPE_WEBHOOK_SECRET            | condicional | prefixo whsec_; Stripe real |
# | STRIPE_*_PRICE_ID (6 variáveis)  | condicional | obrigatórias se Stripe real |
# | RESEND_API_KEY                   | opcional    | warn — emails degradados |
# | META_APP_ID / META_APP_SECRET    | opcional    | warn — OAuth Meta em mock |
# | LEGAL_DOCS_MANIFEST_URL          | opcional    | default: GitHub raw legal-docs/main |
#
# Em development, variáveis ausentes usam defaults locais com aviso no console.
# Em test/CI, o schema é relaxado e defaults seguros são aplicados automaticamente.
